<TABLE name="mock" nrows="541238">
<PARAM arraysize="952" datatype="char" name="sql_query" value="SELECT FLOOR(source_id / ( ( POWER(2, 35) ) * ( POWER(4, ( 12 - 3 )) ) )) AS healpix_, FLOOR(( phot_g_mean_mag_ext - 3 ) / 0.25) AS phot_g_mean_mag_, FLOOR(( ( phot_g_mean_mag_ext - phot_rp_mean_mag_ext ) - ( - 0.4 ) ) / 0.1) AS g_rp_, COUNT ( * ) AS n FROM (SELECT (((random()+random()+random()+random()+random()+random()+random()+random()+random()+random()-5)*(phot_g_mean_mag_error))+(phot_g_mean_mag)) + a0 * A0_1_gaia_g AS phot_g_mean_mag_ext, (((random()+random()+random()+random()+random()+random()+random()+random()+random()+random()-5)*(phot_rp_mean_mag_error))+(phot_rp_mean_mag)) + a0 * A0_1_gaia_rp AS phot_rp_mean_mag_ext, source_id FROM gedr3mock.main JOIN gedr3mock.parsec_props USING ( index_parsec )) AS mock WHERE phot_g_mean_mag_ext - phot_rp_mean_mag_ext &gt; - 0.4 AND phot_g_mean_mag_ext - phot_rp_mean_mag_ext &lt; 2.2 AND phot_g_mean_mag_ext &gt; 3 AND phot_g_mean_mag_ext &lt; 20 GROUP BY healpix_ , phot_g_mean_mag_ , g_rp_ LIMIT 16000000">
<DESCRIPTION>ADQL query translated to local SQL (for debugging)</DESCRIPTION>
</PARAM>
<PARAM arraysize="823" datatype="char" name="query" value="SELECT      floor(source_id / ((power(2, 35)) * (power(4, (12 - 3))))) AS healpix_,     floor((phot_g_mean_mag_ext - 3) / 0.25) AS phot_g_mean_mag_,     floor(((phot_g_mean_mag_ext - phot_rp_mean_mag_ext) - (-0.4)) / 0.1) AS g_rp_,     COUNT(*) AS n FROM (     SELECT GAVO_NORMAL_RANDOM(phot_g_mean_mag, phot_g_mean_mag_error) + a0*A0_1_gaia_g as phot_g_mean_mag_ext,            GAVO_NORMAL_RANDOM(phot_rp_mean_mag, phot_rp_mean_mag_error) + a0*A0_1_gaia_rp as phot_rp_mean_mag_ext,            source_id      FROM gedr3mock.main     JOIN gedr3mock.parsec_props     USING (index_parsec)) as mock WHERE phot_g_mean_mag_ext - phot_rp_mean_mag_ext &gt; -0.4       AND phot_g_mean_mag_ext - phot_rp_mean_mag_ext &lt; 2.2        AND phot_g_mean_mag_ext &gt; 3        AND phot_g_mean_mag_ext &lt; 20 GROUP BY healpix_, phot_g_mean_mag_, g_rp_">
<DESCRIPTION>Original ADQL query</DESCRIPTION>
</PARAM>
